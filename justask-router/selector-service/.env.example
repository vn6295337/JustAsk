# Server Configuration
PORT=3001
NODE_ENV=development

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here   # runtime service: anon key, read-only

# Service role key: ONLY for manual scripts/db/populate_*.js (never set on the runtime service, never in CI)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Admin endpoints (/cache/refresh, /rate-limits/reset): send header X-Admin-Token.
# If unset, these endpoints return 503.
ADMIN_TOKEN=generate-a-long-random-string

# CORS: comma-separated allowed origins. Unset = no cross-origin access. '*' allows all.
CORS_ORIGINS=

# External Services (Optional)
# Use either ARTIFICIALANALYSIS_API_KEY or ARTIFICIAL_ANALYSIS_API_KEY
ARTIFICIALANALYSIS_API_KEY=your-api-key-here

# Caching Configuration
CACHE_TTL=1800000
