# Backend Configuration
PORT=3000
# Defaults to production when unset. Set to development ONLY for local work
# (development mode uses placeholder provider keys).
NODE_ENV=development

# Supabase API Key Vault
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-public-key

# LLM Provider API Keys (stored in Supabase Vault, not local)
# These are retrieved from Supabase at runtime
# GEMINI_API_KEY=your-gemini-key (managed by Supabase)
# GROQ_API_KEY=your-groq-key (managed by Supabase)
# OPENROUTER_API_KEY_2=your-openrouter-key (preferred; OPENROUTER_API_KEY is used as fallback)

# Logging
LOG_LEVEL=debug

# Optional shared-token auth. When set, POST /api/query and /api/queue/sync
# require `Authorization: Bearer <token>` (or `X-API-Key`). When unset, auth is
# disabled. The app sends it if EXPO_PUBLIC_API_TOKEN is set (note: a token
# bundled into a mobile app is extractable; it is a speed bump, not real auth).
# API_AUTH_TOKEN=

# Extra CORS origins, comma-separated (localhost dev origins are built in)
# CORS_ORIGINS=https://example.com

# Inbound per-IP limits (requests/minute). Defaults: 30 and 4.
# RATE_LIMIT_QUERY_PER_MIN=30
# RATE_LIMIT_SYNC_PER_MIN=4
